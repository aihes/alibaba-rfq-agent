# Copy this file to .env.local only when you want to persist local config.
# Do not commit .env.local or any real API key.

# Recommended default: use an OpenRouter key already available in the shell.
# The scripts will map OPENROUTER_API_KEY -> MIDSCENE_MODEL_API_KEY automatically.
OPENROUTER_API_KEY=

# DashScope is kept as a fallback if your account has Qwen-VL permission enabled.
DASHSCOPE_API_KEY=

# Provider auto-selection:
# - openrouter: qwen/qwen3.7-plus, family qwen3
# - dashscope: qwen-vl-max-latest, family qwen2.5-vl
MIDSCENE_PROVIDER=openrouter

MIDSCENE_MODEL_NAME=qwen/qwen3.7-plus
MIDSCENE_MODEL_BASE_URL=https://openrouter.ai/api/v1
MIDSCENE_MODEL_FAMILY=qwen3

# Optional: if you prefer OpenRouter, set these instead in your shell or .env.local.
# MIDSCENE_MODEL_API_KEY=
# MIDSCENE_MODEL_NAME=
# MIDSCENE_MODEL_BASE_URL=
# MIDSCENE_MODEL_FAMILY=
