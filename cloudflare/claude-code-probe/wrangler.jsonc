{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rfq-claude-code-probe",
  "account_id": "896cf17e8a4529974ae1b9dae82c2d23",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "routes": [
    { "pattern": "claude-probe.knowflow.work", "custom_domain": true }
  ],
  "containers": [
    {
      "class_name": "ClaudeCodeProbe",
      "image": "docker.io/library/node:22-slim",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CLAUDE_CODE_PROBE", "class_name": "ClaudeCodeProbe" }
    ]
  },
  "exports": {
    "ClaudeCodeProbe": { "type": "durable-object", "storage": "sqlite" }
  }
}
