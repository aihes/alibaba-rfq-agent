# Web/CLI only: reuse an already logged-in Chrome through the Midscene extension.
# Desktop uses embedded Chromium and receives its private connection internally.
BROWSER_PROVIDER=chrome-bridge
CHROME_BRIDGE_TIMEOUT_MS=20000

# Default: call the authenticated Cloudflare Claude Code service. Never put an
# owner token in a published installer or commit it to git. For CLI runs, set
# RFQ_CLOUD_TOKEN in the local .env or shell; desktop has encrypted settings.
AGENT_PROVIDER=cloud-claude
RFQ_CLOUD_TOKEN=
RFQ_CLOUD_AGENT_URL=https://glm.knowflow.work/v1/agent

# Optional local-Claude mode: set AGENT_PROVIDER=local-claude-sdk and configure
# the installed Claude CLI. It inherits your existing Anthropic-compatible env.
LOCAL_CLAUDE_EXECUTABLE=claude

# Leave empty to inherit the model configured by local Claude Code. Set an
# override only after the gateway confirms its exact identifier.
LOCAL_CLAUDE_MODEL=
# Keep user/project hooks out of unattended runs. Credentials and gateway env
# vars are still inherited. Set to user only if you have audited all hooks.
LOCAL_CLAUDE_SETTING_SOURCES=none
LOCAL_CLAUDE_STRUCTURED_OUTPUT=false
LOCAL_CLAUDE_TIMEOUT_MS=120000
LOCAL_CLAUDE_MAX_BUDGET_USD=0.20
USE_CLAUDE=true
USE_CLAUDE_DRAFT=true

# Default OCR uses the same owner service and client token. To call GLM-OCR
# directly, choose OCR_PROVIDER=glm-ocr and supply an official GLM key.
# Set OCR_PROVIDER=off to disable uploads.
OCR_PROVIDER=cloud-ocr
RFQ_CLOUD_OCR_TOKEN=
GLM_OCR_API_KEY=
GLM_OCR_API_URL=
OCR_TIMEOUT_MS=60000
# Legacy mode name local-ocr means the analysis model receives OCR text;
# it no longer implies that OCR runs offline. agent-read also sends pixels.
IMAGE_ANALYSIS_MODE=agent-read
MAX_RFQ_IMAGES=4
MAX_IMAGE_BYTES=5242880

# Optional direct text model API. For CLI use AGENT_PROVIDER=openai-http.
MODEL_API_KEY=
MODEL_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
MODEL_NAME=glm-5.3

# Optional direct Anthropic HTTP fallback. Use only with
# AGENT_PROVIDER=anthropic-http. This path does not read RFQ images.
ANTHROPIC_API_KEY=
ANTHROPIC_HTTP_MODEL=

# Required before form filling. For EXW use the verified factory city/location;
# for FOB use the verified loading port. Do not guess this value.
QUOTE_PORT=

# Poll conservatively. The script never bypasses CAPTCHA or login checks.
POLL_INTERVAL_SECONDS=600
# 0 includes all publication dates; records with unrecognized publication time
# are excluded from a finite window and remain available when set to 0.
RECENT_RFQ_MINUTES=60

# Live submission is disabled by default. Enabling it still requires an exact
# per-RFQ --confirm token printed by the CLI.
ALLOW_LIVE_SUBMIT=false

# Automatic buyer contact is disabled by default. "fill" stops before submit;
# "submit" sends the quotation and buyer message. Submit mode additionally
# requires ALLOW_LIVE_SUBMIT=true and the exact acknowledgement below.
AUTO_CONTACT_MODE=off
AUTO_CONTACT_CATEGORIES=
AUTO_CONTACT_MIN_CONFIDENCE=0.92
AUTO_CONTACT_DAILY_LIMIT=3
AUTO_CONTACT_MAX_TOTAL_USD=2500
AUTO_CONTACT_ACK=
