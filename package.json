{
  "name": "alibaba-rfq-agent",
  "version": "0.7.21",
  "private": true,
  "type": "module",
  "description": "Alibaba RFQ desktop assistant with an isolated embedded Chromium browser, guarded pricing and quote review.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run cases:up",
    "once": "node src/cli.js once",
    "watch": "node src/cli.js watch",
    "fill": "node src/cli.js fill",
    "submit": "node src/cli.js submit",
    "contact": "node src/cli.js contact",
    "doctor": "node src/cli.js doctor",
    "cases:build": "node scripts/build_case_catalog.mjs",
    "cases:up": "npm run cases:build && npm run cases:serve",
    "cases:serve": "node scripts/serve_case_catalog.mjs",
    "test": "node --test tests/*.test.js cloudflare/claude-code-probe/src/*.test.js",
    "midscene:status": "node plugins/alibaba-rfq-midscene/scripts/cli.mjs status",
    "midscene:scan": "node plugins/alibaba-rfq-midscene/scripts/cli.mjs scan",
    "midscene:analyze": "node plugins/alibaba-rfq-midscene/scripts/cli.mjs analyze",
    "midscene:fill": "node plugins/alibaba-rfq-midscene/scripts/cli.mjs fill",
    "midscene:submit": "node plugins/alibaba-rfq-midscene/scripts/cli.mjs submit",
    "desktop:install-runtime": "node node_modules/electron/install.js",
    "desktop:dev": "npm run desktop:install-runtime && node scripts/run-electron.mjs .",
    "desktop:pack": "npm run desktop:install-runtime && electron-builder --dir",
    "desktop:dist": "npm run desktop:install-runtime && electron-builder --mac --arm64 --publish never",
    "desktop:dist:win": "node scripts/build-windows.mjs",
    "notifications:tool": "node scripts/notification-tools.mjs",
    "desktop:check": "node scripts/check-desktop-package.mjs",
    "desktop:test:browser": "node scripts/run-electron.mjs scripts/electron-browser-smoke.mjs",
    "desktop:test:session": "node scripts/electron-session-restart-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.274",
    "@midscene/web": "^1.12.9",
    "adm-zip": "^0.6.1",
    "dotenv": "^16.6.1",
    "sharp": "0.35.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "main": "src/desktop/main.js"
}
